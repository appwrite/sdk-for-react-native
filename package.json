{
    "name": "react-native-appwrite",
    "homepage": "https://appwrite.io/support",
    "description": "Appwrite is an open-source self-hosted backend server that abstracts and simplifies complex and repetitive development tasks behind a very simple REST API",
    "version": "3.1.0",
    "license": "BSD-3-Clause",
    "main": "dist/cjs/sdk.js",
    "exports": {
        ".": {
            "import": "./dist/esm/sdk.js",
            "require": "./dist/cjs/sdk.js",
            "types": "./types/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "module": "dist/esm/sdk.js",
    "types": "types/index.d.ts",
    "files": [
        "android",
        "!android/build",
        "dist",
        "ios",
        "*.podspec",
        "react-native.config.js",
        "types"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/appwrite/sdk-for-react-native"
    },
    "scripts": {
        "build": "npm run build:types && npm run build:libs",
        "build:types": "tsc --declaration --emitDeclarationOnly --outDir types",
        "build:libs": "rollup -c",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "analyse": "tsc --noEmit"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.13.0",
        "expo-file-system": "58.0.9",
        "@rollup/plugin-typescript": "12.3.0",
        "@types/json-bigint": "1.0.4",
        "@types/node": "24.19.2",
        "@types/readable-stream": "4.0.25",
        "playwright": "1.59.0",
        "prettier": "3.9.10",
        "rollup": "4.64.10",
        "serve-handler": "6.1.7",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2"
    },
    "dependencies": {
        "buffer": "6.0.3",
        "json-bigint": "1.0.0",
        "mqtt": "5.16.1",
        "process": "0.11.10",
        "readable-stream": "4.8.0"
    },
    "peerDependencies": {
        "expo": ">=52.0.0",
        "expo-file-system": ">=18.0.0",
        "expo-notifications": "*",
        "react-native": ">=0.76.7 <1.0.0",
        "react-native-background-actions": ">=4.0.0 <5.0.0",
        "react-native-tcp-socket": ">=6.2.0 <7.0.0"
    },
    "peerDependenciesMeta": {
        "expo-notifications": {
            "optional": true
        },
        "react-native-background-actions": {
            "optional": true
        },
        "react-native-tcp-socket": {
            "optional": true
        }
    },
    "overrides": {
        "glob": {
            ".": "^13.0.0",
            "brace-expansion": "5.0.12"
        },
        "brace-expansion": "5.0.12",
        "rimraf": "^6.0.0",
        "@xmldom/xmldom": "^0.9.10",
        "uuid": "^14.0.0",
        "postcss": "^8.5.18",
        "ws": "^8.20.1"
    }
}
